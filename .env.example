# Copy to .env and adjust. Never commit .env.
# Same password as in planlos-db's .env
POSTGRES_PASSWORD=change-me
# Database host on the shared network (alias set in planlos-db's compose.yml)
DB_HOST=planlos-db
# Network created by planlos-db
PLANLOS_NETWORK=planlos-network
# Any non-empty value disables the authorized-user check (development only!)
NO_AUTH=
SERVER_PORT=8004
